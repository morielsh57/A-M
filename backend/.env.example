# PayPal REST API credentials. Use sandbox credentials for local development.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=https://localhost:3001/checkout/paypal/success
PAYPAL_CANCEL_URL=https://localhost:3001/checkout/paypal/cancel
PAYPAL_REQUEST_TIMEOUT_SECONDS=15
