{
  "compilerOptions": {
    "target": "es6",
    "lib": [
      "ES6",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    ///
    // "typeRoots": [
    //   "./types",
    //   "node_modules/@types"
    // ],
    // "noImplicitAny": false,
    // "sourceMap": true,
    // "strictNullChecks": false,
    // "strictPropertyInitialization": false,
    // "experimentalDecorators": true,
    // "declaration": false,
    // "removeComments": true,
    // // "noImplicitReturns": true,
    // "noUnusedLocals": false,
    ///
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "paths": {
      "@material-ui/core/*": [
        "./src/compat/material-ui/core/*"
      ],
      "@material-ui/icons/*": [
        "./src/compat/material-ui/icons/*"
      ],
      "@material-ui/lab/*": [
        "./src/compat/material-ui/lab/*"
      ],
      "antd": [
        "./src/compat/antd.tsx"
      ],
      "antd/dist/antd.css": [
        "./src/compat/antd.css"
      ],
      "react-google-maps": [
        "./src/compat/react-google-maps.tsx"
      ],
      "react-paypal-button-v2": [
        "./src/compat/react-paypal-button-v2.tsx"
      ],
      "react-toast-notifications": [
        "./src/compat/react-toast-notifications.tsx"
      ],
      "redux-devtools-extension": [
        "./src/compat/redux-devtools-extension.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ]
}
